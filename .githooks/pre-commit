#!/usr/bin/env bash
# Refuse a commit that CI would reject, before it becomes a push.
#
# This exists because of a specific mistake rather than a general principle. A round was committed
# and pushed while `untell-audit` was failing: the audit and the commit ran in one shell sequence
# that did not gate on the audit's exit code, so an unattributed figure went out and was fixed in a
# follow-up commit. CI would have caught it — after the push, in a public failure, on a branch
# somebody else might have pulled.
#
# Scoped by what changed, because a gate slow enough to skip is a gate nobody runs:
#   * ruff, always — it is fast and its findings are always real.
#   * the documentation guards, only when documentation or the roadmap changed.
#   * `untell-audit`, only when a live document changed, because it takes about a minute.
#
# Install with:  git config core.hooksPath .githooks
# Bypass with:   git commit --no-verify   (for a work-in-progress commit you do not intend to push)
set -uo pipefail

changed=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$changed" ] && exit 0

fail() { printf '\n\033[31mpre-commit: %s\033[0m\n' "$1" >&2; exit 1; }

# Never commit a sabotaged module. `scripts/mutation_sweep.py` rewrites source files in place —
# replacing every public function body with a raise — and restores them when it finishes. While it
# runs, `git status` reports the module it is working on as modified, and a `git add -A` would
# commit a file whose every function raises. The sweep refuses to START on a dirty tree; nothing
# stopped a commit landing mid-sweep. This does.
#
# Deliberately keyed on the marker rather than a lockfile: it catches sabotage from any source,
# including a crashed run that never restored its file, which is the case a lockfile would miss.
# Scoped to the directories the sweep actually rewrites. The first version grepped the whole staged
# diff and refused the commit that ADDED it — this hook and its tests contain the marker as a
# literal, which is not sabotage. A guard that cannot tell a broken module from a file discussing
# broken modules is a guard that gets bypassed.
for f in $(printf '%s\n' "$changed" | grep -E '^(untell|eval)/.*\.py$' || true); do
    if git show ":$f" 2>/dev/null | grep -q 'raise AssertionError("sabotaged")'; then
        fail "$f is staged with the mutation-sweep sabotage marker in it. A sweep is probably running, or one crashed without restoring. Restore it with \`git checkout $f\`."
    fi
done

if printf '%s\n' "$changed" | grep -qE '\.py$'; then
    command -v ruff >/dev/null 2>&1 || { echo "pre-commit: ruff not installed, skipping lint" >&2; }
    if command -v ruff >/dev/null 2>&1; then
        ruff check . || fail "ruff found issues. Fix them, or commit with --no-verify if this is a WIP."
    fi
fi

# `test_every_audit_check_can_fail.py` is in this list for a specific reason. It is the guard that
# notices a document stating a count next to a noun the audit tracks — "N tests", "N modules" — and
# it was NOT run here for the first fifty-two rounds. Four times a ledger entry DESCRIBING a
# count-drift defect reproduced the literal string it warns about and re-triggered the check, and all
# four reached the remote before anyone noticed, because the hook ran the other three doc guards and
# not this one. It costs about twenty-five seconds and only on a Markdown change.
docs_changed=$(printf '%s\n' "$changed" | grep -E '\.md$' || true)
if [ -n "$docs_changed" ]; then
    python -m pytest -q -p no:randomly \
        tests/test_docs_claims.py \
        tests/test_roadmap_status.py \
        tests/test_retracted_claims_do_not_survive_elsewhere.py \
        tests/test_every_audit_check_can_fail.py \
        >/dev/null 2>&1 || fail "documentation guards failed. Run them to see which."
fi

# The link check CI runs as a gate, and the one this hook's author ran by hand every round for
# fifty-three rounds — which is the clearest possible sign it belonged here. `mkdocs build --strict`
# is a LINK CHECKER, not a publish step: its first run in CI found 47 broken cross-references. A
# dead link in a document is invisible to every other guard, because the audit reads claims and the
# doc tests read counts, and neither follows a href.
if [ -n "$docs_changed" ] && command -v mkdocs >/dev/null 2>&1; then
    mkdocs build --strict --site-dir /tmp/untell-hook-site >/dev/null 2>&1 \
        || fail "mkdocs --strict failed: a documentation link does not resolve. Run \`mkdocs build --strict\`."
fi

# Attribution says a figure named a source; this says the source still contains it. Round
# eighty-four found a published AUROC whose own reproduction command printed a different number, by
# reading. `eval/claim_verification.py` holds a registry of the headline figures and fails when an
# artefact moves and the prose does not — or the other way round. It is fast and needs no corpus.
if [ -n "$docs_changed" ] || printf '%s\n' "$changed" | grep -q '^eval/data/'; then
    python -m eval.claim_verification >/dev/null 2>&1 \
        || fail "a published headline figure no longer matches its artefact. Run \`python -m eval.claim_verification\`."
fi

# The live documents are the ones `untell-audit` reads; nothing else triggers the slow check.
if printf '%s\n' "$docs_changed" | grep -qE '^(README|ROADMAP|ai-writing-research)\.md$|^docs/'; then
    python -m untell.scripts.audit >/dev/null 2>&1 \
        || fail "untell-audit failed — most likely a bolded figure with no stated source. Run \`untell-audit\`."
fi

exit 0
